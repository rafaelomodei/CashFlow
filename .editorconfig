root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

# Organização de usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Namespaces
csharp_style_namespace_declarations = file_scoped:warning

# `this.` desnecessário
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Tipos de linguagem em vez de tipos do BCL
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Imutabilidade — apoia a premissa P-05 e as entidades sem setter público
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion

# Expressões modernas
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_null_propagation = true:warning
csharp_style_coalesce_expression = true:warning

# Chaves sempre — evita bug de linha adicional em `if` sem bloco
csharp_prefer_braces = true:warning

# Nomenclatura
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbol
dotnet_naming_rule.types_are_pascal_case.style = pascal_case_style
dotnet_naming_symbols.type_symbol.applicable_kinds = class,struct,enum,delegate
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_are_camel_case_with_underscore.severity = warning
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.style = underscore_camel_case_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

# Migrations são saída de `dotnet ef migrations add`. Marcá-las como código
# gerado evita a escolha entre reescrever a ferramenta a cada migration e
# afrouxar o estilo do restante do projeto.
[**/Persistence/Migrations/*.cs]
generated_code = true

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2
