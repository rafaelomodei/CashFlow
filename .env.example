# Copie para `.env` antes de subir o ambiente:
#   cp .env.example .env && docker compose up -d
#
# `.env` está no .gitignore — credenciais reais nunca entram no repositório.
# Os valores abaixo são de desenvolvimento local e não servem para produção.

# --- cashflow_db ---------------------------------------------------------
CASHFLOW_DB_NAME=cashflow_db
CASHFLOW_DB_USER=cashflow
CASHFLOW_DB_PASSWORD=cashflow
CASHFLOW_DB_PORT=5432

# --- consolidation_db ----------------------------------------------------
CONSOLIDATION_DB_NAME=consolidation_db
CONSOLIDATION_DB_USER=consolidation
CONSOLIDATION_DB_PASSWORD=consolidation
CONSOLIDATION_DB_PORT=5433

# --- rabbitmq ------------------------------------------------------------
RABBITMQ_USER=cashflow
RABBITMQ_PASSWORD=cashflow
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- aplicações ----------------------------------------------------------
CASHFLOW_API_PORT=5001
CONSOLIDATION_API_PORT=5002
FRONTEND_PORT=3000
ASPNETCORE_ENVIRONMENT=Development
